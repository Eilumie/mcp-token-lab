{
  "type": "token-lab-template",
  "version": 1,
  "name": "tool-result-shaping",
  "description": "Raw Tool Result (Baseline) vs Field Projection (1.5K/Tool) vs Code Aggregation (~1.5K/Batch)",
  "config": {
    "unit": "K",
    "baselineId": "plan-1",
    "plans": [
      {
        "id": "plan-1",
        "name": "Raw Tool Result (Baseline)",
        "description": "Raw: {{toolResultToken}}K per tool, ~{{turnAvgToolsCount}} tools/turn; {{turnTotalCount}} turns; compact at {{compressionThresholdToken}}K tokens.",
        "color": "#5869d9",
        "estimateDuration": true,
        "simulation": {
          "flow": {
            "initial": [
              {
                "type": "action",
                "text": "agent prompt",
                "token": "initialContext.agentPromptToken",
                "durationSeconds": 0
              },
              {
                "type": "action",
                "text": "skills discover list",
                "token": "skillsTotalCount * skillIndexToken",
                "durationSeconds": 0
              },
              {
                "type": "action",
                "text": "tools discover list",
                "token": "toolsTotalCount * toolsIndexToken",
                "durationSeconds": 0
              },
              {
                "type": "action",
                "text": "tools schema list",
                "token": "toolsTotalCount * toolSchemaToken",
                "durationSeconds": 0
              }
            ],
            "turn": [
              {
                "type": "action",
                "text": "user_message",
                "token": "userMessageToken",
                "durationSeconds": 0
              },
              {
                "type": "llm",
                "text": "read_skills_plan",
                "token": "readSkillPlanToken",
                "durationSeconds": 1.8
              },
              {
                "type": "action",
                "text": "read_skills",
                "token": "skillDetailToken * turnAvgSkillsCount",
                "durationSeconds": 0.3
              },
              {
                "type": "llm",
                "text": "call_tools_plan",
                "token": "callToolsPlanToken",
                "durationSeconds": 1.8
              },
              {
                "type": "action",
                "text": "call_tools",
                "token": "toolResultToken * turnAvgToolsCount",
                "durationSeconds": 1
              },
              {
                "type": "llm",
                "text": "agent_result",
                "token": "agentResult",
                "durationSeconds": 1.8
              }
            ]
          },
          "variables": {},
          "initialContext": {
            "agentPromptToken": 4
          },
          "turnTotalCount": 100,
          "expectedPrefixCacheHitRate": 0.9,
          "skillsTotalCount": 30,
          "toolsTotalCount": 120,
          "turnAvgSkillsCount": 0.33,
          "turnAvgToolsCount": 1.5,
          "skillIndexToken": 0.1,
          "toolsIndexToken": 0.013,
          "toolSchemaToken": 0.51,
          "userMessageToken": 0.1,
          "skillDetailToken": 3,
          "toolResultToken": 5,
          "readSkillPlanToken": 0.1,
