          "compressionThresholdTurnCount": 10,
          "compressionTargetToken": 2,
          "compressionKeepTurns": 1
        },
        "model": {
          "name": "Demo Model (Illustrative Rates)",
          "currency": "$",
          "inputCachedPrice": 0.2,
          "inputNotCachedPrice": 2,
          "outputPrice": 8
