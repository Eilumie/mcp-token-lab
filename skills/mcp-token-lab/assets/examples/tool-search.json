{
  "type": "token-lab-template",
  "version": 1,
  "name": "tool-search",
  "description": "Full Schema (Baseline) vs Regex Search (Top 5) vs BM25 Search (Top 5) vs Semantic Search (Top 5)",
  "config": {
    "unit": "K",
    "baselineId": "plan-1",
    "plans": [
      {
        "id": "plan-1",
        "name": "Full Schema (Baseline)",
        "description": "Full schema loading: preload {{toolsTotalCount}} schemas; {{turnTotalCount}} turns; compact at {{compressionThresholdToken}}K tokens.",
        "color": "#5869d9",
        "estimateDuration": true,
        "simulation": {
          "flow": {
            "initial": [
              {
                "type": "action",
                "text": "agent prompt",
                "token": "initialContext.agentPromptToken",
                "durationSeconds": 0
              },
              {
                "type": "action",
                "text": "skills discover list",
                "token": "skillsTotalCount * skillIndexToken",
                "durationSeconds": 0
              },
              {
                "type": "action",
                "text": "tools discover list",
                "token": "toolsTotalCount * toolsIndexToken",
                "durationSeconds": 0
              },
              {
                "type": "action",
                "text": "tools schema list",
                "token": "toolsTotalCount * toolSchemaToken",
                "durationSeconds": 0
              }
            ],
            "turn": [
              {
                "type": "action",
                "text": "user_message",
                "token": "userMessageToken",
                "durationSeconds": 0
              },
              {
                "type": "llm",
                "text": "read_skills_plan",
                "token": "readSkillPlanToken",
                "durationSeconds": 1.8
              },
              {
                "type": "action",
                "text": "read_skills",
                "token": "skillDetailToken * turnAvgSkillsCount",
                "durationSeconds": 0.3
              },
              {
                "type": "llm",
                "text": "call_tools_plan",
                "token": "callToolsPlanToken",
                "durationSeconds": 1.8
              },
              {
                "type": "action",
                "text": "call_tools",
                "token": "toolResultToken * turnAvgToolsCount",
                "durationSeconds": 1
              },
              {
                "type": "llm",
                "text": "agent_result",
                "token": "agentResult",
                "durationSeconds": 1.8
              }
            ]
          },
          "variables": {
            "searchTopK": {
              "label": "Schemas returned per search",
              "value": 5
            },
            "searchPlanOutput": {
              "label": "Search planning output (K)",
              "value": 0.1
            }
          },
          "initialContext": {
            "agentPromptToken": 4
          },
          "turnTotalCount": 100,
          "expectedPrefixCacheHitRate": 0.9,
          "skillsTotalCount": 30,
          "toolsTotalCount": 120,
          "turnAvgSkillsCount": 0.33,
          "turnAvgToolsCount": 1.5,
          "skillIndexToken": 0.1,
          "toolsIndexToken": 0.013,
          "toolSchemaToken": 0.51,
          "userMessageToken": 0.1,
          "skillDetailToken": 3,
          "toolResultToken": 3,
          "readSkillPlanToken": 0.1,
